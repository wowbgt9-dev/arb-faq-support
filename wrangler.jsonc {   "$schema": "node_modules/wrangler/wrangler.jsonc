
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arb-faq-support",
  "main": "src/index.js",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arb-faq-database",
      "database_id": "MASUKKAN_DATABASE_ID_CLOUDFLARE_KAMU"
    }
  ]
}
